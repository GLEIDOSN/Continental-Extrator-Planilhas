@page "/extracao-vendas"
@attribute [Authorize]
@using System.Globalization
@using System.Diagnostics
@using ContinentalSistemas.App.Diagnostics
@using ContinentalSistemas.Application.Dtos
@using ContinentalSistemas.Application.Interfaces.Services
@inject MonitorCircuito MonitorCircuito
@inject IExtracaoVendasService ExtracaoService
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject ILogger<ExtracaoVendas> Logger
@rendermode InteractiveServer

<PageTitle>Extração de vendas</PageTitle>

<h1 class="h4 mb-4">Extração de Planilhas de Vendas</h1>

<div class="row g-3">
    <div class="col-12 col-xl-4">
        <section class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white fw-semibold">Parâmetros da extração</div>
            <div class="card-body">
                <fieldset disabled="@ocupado">
                    <div class="mb-3">
                        <label for="empresa" class="form-label">Loja / Servidor de destino <span class="text-danger">*</span></label>
                        <select id="empresa" class="form-select" @bind="empresa" @bind:after="LimparResultado">
                            <option value="">Selecione uma loja</option>
                            <option value="Winthor">Winthor</option>
                        </select>
                        <div class="form-text">Base onde a consulta de vendas será executada.</div>
                    </div>
                    <div class="mb-3">
                        <label for="dataArquivo" class="form-label">Data do arquivo <span class="text-danger">*</span></label>
                        <input id="dataArquivo" class="form-control" type="date" @bind="dataArquivo" />
                        <div class="form-text">Utilizada no nome do arquivo, não como filtro da consulta.</div>
                    </div>
                    <div class="mb-3">
                        <label for="complemento" class="form-label">Complemento do nome do arquivo <span class="text-danger">*</span></label>
                        <input id="complemento" class="form-control" maxlength="60" placeholder="Ex.: Loja Nova" @bind="complemento" @bind:event="oninput" />
                        <div class="form-text">Obrigatório para compor o nome do arquivo Excel.</div>
                    </div>
                    <div class="mb-3">
                        <label for="numeros" class="form-label">Números das vendas <span class="text-danger">*</span></label>
                        <textarea id="numeros" class="form-control" rows="6" placeholder="Ex.: 32418, 32428, 3243" @bind="numerosTexto" @bind:event="oninput" @bind:after="LimparResultado"></textarea>
                        <div class="form-text">Separe os números por vírgula, ponto e vírgula, espaço ou quebra de linha (até 1.000 vendas).</div>
                    </div>
                    <button type="button" class="btn btn-primary w-100 mb-2" disabled="@ocupado" @onclick="ConsultarAsync">
                        @if (ocupado)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Consultando Oracle...</span>
                        }
                        else
                        {
                            <span>Consultar</span>
                        }
                    </button>
                    <button type="button" class="btn btn-success w-100" disabled="@(ocupado || itens.Count == 0 || !dataArquivo.HasValue || string.IsNullOrWhiteSpace(complemento))" @onclick="ExportarAsync">Exportar para planilha (.xls)</button>
                </fieldset>
                @if (!string.IsNullOrEmpty(erro))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@erro</div>
                }
                @if (inexistentes.Count > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0" role="alert">Vendas não encontradas ou canceladas: @string.Join(", ", inexistentes). Nenhuma planilha foi gerada.</div>
                }
            </div>
        </section>
    </div>
    <div class="col-12 col-xl-8">
        <section class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Pré-visualização do resultado</span>
                @if (itens.Count > 0)
                {
                    <span class="badge bg-success">@itens.Count registro(s) encontrado(s)</span>
                }
            </div>
            <div class="card-body p-0">
                @if (ocupado && itens.Count == 0)
                {
                    <div class="text-muted text-center p-5"><span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Consultando vendas...</div>
                }
                else if (itens.Count == 0)
                {
                    <div class="text-muted text-center p-5">@(consultado ? "Nenhum item encontrado para as vendas informadas." : "Informe os parâmetros e clique em Consultar.")</div>
                }
                else
                {
                    <div class="table-responsive resultado">
                        <table class="table table-striped table-hover table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>PRO_CODIGO</th><th>COD_R3MAGAZINE</th><th>PRO_DESCRICAO</th><th>PRO_REFERENCIA</th><th class="text-end">QUANTIDADE</th><th>VENDA</th><th class="text-end">CUSTO</th><th class="text-end">PRECO_LOJA</th><th class="text-end">CUSTO_TOTAL</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in itens)
                                {
                                    <tr>
                                        <td>@item.ProCodigo</td><td>@item.CodR3Magazine</td><td>@item.ProDescricao</td><td>@item.ProReferencia</td>
                                        <td class="text-end">@item.Quantidade.ToString("N0", cultura)</td><td>@item.Venda</td>
                                        <td class="text-end">@item.Custo.ToString("C", cultura)</td><td class="text-end">@((0m).ToString("C", cultura))</td><td class="text-end">@item.CustoTotal.ToString("C", cultura)</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-semibold">
                                <tr><td colspan="4">Total consolidado</td><td class="text-end">@itens.Sum(i => i.Quantidade).ToString("N0", cultura)</td><td colspan="3"></td><td class="text-end">@itens.Sum(i => i.CustoTotal).ToString("C", cultura)</td></tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@if (!ocupado && (diagnosticoConsulta is not null || erroDiagnostico is not null))
{
    <section class="card shadow-sm mt-3" aria-live="polite" aria-labelledby="titulo-diagnostico">
        <div class="card-header bg-dark text-white fw-semibold d-flex justify-content-between align-items-center">
            <span id="titulo-diagnostico">Diagnóstico da consulta (Debug)</span>
            <button type="button" class="btn btn-sm btn-outline-light" @onclick="FecharDiagnostico">Fechar</button>
        </div>
        <div class="card-body">
            @if (diagnosticoConsulta is { } diagnostico)
            {
                <dl class="row mb-2">
                    <dt class="col-sm-4">Resultado</dt><dd class="col-sm-8">@diagnostico.Resultado</dd>
                    <dt class="col-sm-4">Início</dt><dd class="col-sm-8">@diagnostico.Inicio.Instante.ToString("dd/MM/yyyy HH:mm:ss.fff", cultura)</dd>
                    <dt class="col-sm-4">Fim</dt><dd class="col-sm-8">@diagnostico.Fim.Instante.ToString("dd/MM/yyyy HH:mm:ss.fff", cultura)</dd>
                    <dt class="col-sm-4">Tempo decorrido</dt><dd class="col-sm-8">@diagnostico.Duracao.TotalMilliseconds.ToString("N2", cultura) ms</dd>
                    <dt class="col-sm-4">CPU do processo</dt><dd class="col-sm-8">@diagnostico.CpuPercentual.ToString("N2", cultura)% em média; @diagnostico.Cpu.TotalMilliseconds.ToString("N2", cultura) ms de processamento</dd>
                    <dt class="col-sm-4">Memória privada</dt><dd class="col-sm-8">@EmMebibytes(diagnostico.Inicio.MemoriaPrivada) MiB no início; @EmMebibytes(diagnostico.Fim.MemoriaPrivada) MiB no fim</dd>
                    <dt class="col-sm-4">Memória residente (working set)</dt><dd class="col-sm-8">@EmMebibytes(diagnostico.Inicio.WorkingSet) MiB no início; @EmMebibytes(diagnostico.Fim.WorkingSet) MiB no fim</dd>
                </dl>
                <p class="text-muted mb-0">CPU e memória referem-se ao processo servidor inteiro, incluindo outras atividades e usuários. A CPU média é normalizada pelo número de processadores lógicos; as amostras de memória não representam necessariamente o pico. A duração inclui a consulta e a leitura dos dados, mas não a renderização ou a exportação da planilha.</p>
            }
            @if (erroDiagnostico is not null)
            {
                <p class="text-warning-emphasis mb-0">@erroDiagnostico</p>
            }
        </div>
    </section>
}

@code {
    private static readonly CultureInfo cultura = CultureInfo.GetCultureInfo("pt-BR");
    private string empresa = "Winthor";
    private DateTime? dataArquivo;
    private string complemento = string.Empty;
    private string numerosTexto = string.Empty;
    private List<ExtracaoVendaItemDto> itens = [];
    private List<long> inexistentes = [];
    private string? erro;
    private bool ocupado;
    private bool consultado;
    private string? extracaoId;
    private DiagnosticoConsulta? diagnosticoConsulta;
    private string? erroDiagnostico;

    private sealed record AmostraProcesso(DateTimeOffset Instante, TimeSpan Cpu, long MemoriaPrivada, long WorkingSet);
    private sealed record DiagnosticoConsulta(AmostraProcesso Inicio, AmostraProcesso Fim, TimeSpan Duracao, TimeSpan Cpu, double CpuPercentual, string Resultado);

    private static string EmMebibytes(long bytes) => (bytes / 1048576d).ToString("N2", cultura);

    private void FecharDiagnostico()
    {
        diagnosticoConsulta = null;
        erroDiagnostico = null;
    }

    private void LimparResultado()
    {
        itens = [];
        inexistentes = [];
        erro = null;
        consultado = false;
        extracaoId = null;
        FecharDiagnostico();
    }

    private async Task ConsultarAsync()
    {
        LimparResultado();
        if (empresa != "Winthor" || !dataArquivo.HasValue)
        {
            erro = "Selecione a loja e informe a data do arquivo.";
            return;
        }
        if (string.IsNullOrWhiteSpace(complemento))
        {
            erro = "Informe o complemento do nome do arquivo.";
            return;
        }

        var partes = numerosTexto.Split([',', ';', ' ', '\r', '\n', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var numeros = new List<long>();
        foreach (var parte in partes)
        {
            if (!long.TryParse(parte, NumberStyles.None, CultureInfo.InvariantCulture, out var numero) || numero <= 0)
            {
                erro = "Informe somente números de vendas inteiros e positivos.";
                return;
            }
            numeros.Add(numero);
        }
        numeros = numeros.Distinct().ToList();
        if (numeros.Count == 0 || numeros.Count > 1000)
        {
            erro = "Informe entre 1 e 1.000 números de vendas distintos.";
            return;
        }

        var host = Configuration["WinthorOracle:Host"];
        if (string.IsNullOrWhiteSpace(host))
        {
            erro = "Configure WinthorOracle:Host com o endereço do servidor Oracle antes de consultar.";
            return;
        }

        ocupado = true;
        StateHasChanged();
        extracaoId = Guid.NewGuid().ToString("N");
        using var escopo = Logger.BeginScope("ExtracaoId={ExtracaoId} CircuitoId={CircuitoId}", extracaoId, MonitorCircuito.Id);
        var cronometro = Stopwatch.StartNew();
        var resultado = "Erro";
#if DEBUG
        var inicio = CapturarAmostraProcesso();
#endif
        try
        {
            var servidor = new ServidorDto { Descricao = "Winthor", Ip = host.Trim(), Ativo = true };
            inexistentes = await ExtracaoService.ObterNumerosVendasInexistentesAsync(servidor, numeros);
            if (inexistentes.Count > 0)
            {
                resultado = "VendasInexistentes";
                return;
            }

            itens = await ExtracaoService.ExtrairItensVendasPorEcfAsync(servidor, numeros);
            consultado = true;
            resultado = "Sucesso";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao consultar vendas no Winthor.");
            erro = "Não foi possível consultar as vendas no Winthor. Verifique a conexão e consulte os registros da aplicação.";
        }
        finally
        {
            cronometro.Stop();
#if DEBUG
            if (inicio is not null && CapturarAmostraProcesso() is { } fim)
            {
                var cpu = fim.Cpu - inicio.Cpu;
                var percentual = cronometro.Elapsed.TotalMilliseconds > 0
                    ? cpu.TotalMilliseconds / cronometro.Elapsed.TotalMilliseconds / Environment.ProcessorCount * 100
                    : 0;
                diagnosticoConsulta = new DiagnosticoConsulta(inicio, fim, cronometro.Elapsed, cpu, percentual, resultado switch
                {
                    "Sucesso" => "Consulta concluída",
                    "VendasInexistentes" => "Vendas não encontradas ou canceladas",
                    _ => "Consulta interrompida por erro"
                });
            }
#endif
            Logger.LogInformation("Desempenho consulta: extracaoId={ExtracaoId}, circuitoId={CircuitoId}, vendas={QuantidadeVendas}, itens={QuantidadeItens}, inexistentes={QuantidadeInexistentes}, duracaoMs={DuracaoMs}, resultado={Resultado}",
                extracaoId, MonitorCircuito.Id, numeros.Count, itens.Count, inexistentes.Count, cronometro.Elapsed.TotalMilliseconds, resultado);
            ocupado = false;
        }
    }

#if DEBUG
    private AmostraProcesso? CapturarAmostraProcesso()
    {
        try
        {
            using var processo = Process.GetCurrentProcess();
            processo.Refresh();
            return new AmostraProcesso(DateTimeOffset.Now, processo.TotalProcessorTime, processo.PrivateMemorySize64, processo.WorkingSet64);
        }
        catch (Exception ex) when (ex is InvalidOperationException or System.ComponentModel.Win32Exception or NotSupportedException)
        {
            Logger.LogWarning(ex, "Não foi possível medir os recursos do processo durante a consulta.");
            erroDiagnostico = "Não foi possível medir os recursos do processo. Consulte os registros da aplicação.";
            return null;
        }
    }
#endif

    private async Task ExportarAsync()
    {
        if (ocupado || itens.Count == 0)
            return;
        if (empresa != "Winthor" || !dataArquivo.HasValue || string.IsNullOrWhiteSpace(complemento))
        {
            erro = "Selecione a loja e informe a data e o complemento do nome do arquivo.";
            return;
        }
        if (itens.Count > 65535)
        {
            erro = "O formato XLS permite no máximo 65.535 itens por planilha. Reduza a quantidade de vendas consultadas.";
            return;
        }

        ocupado = true;
        erro = null;
        var id = extracaoId;
        var quantidadeItens = itens.Count;
        using var escopo = Logger.BeginScope("ExtracaoId={ExtracaoId} CircuitoId={CircuitoId}", id, MonitorCircuito.Id);
        var cronometro = Stopwatch.StartNew();
        double? geracaoMs = null;
        double? transferenciaMs = null;
        var tamanhoBytes = 0;
        var sucesso = false;
        RegistrarMemoria("AntesExportacao", id);
        try
        {
            var nomeComplemento = string.Join("_", complemento.Trim().Split(Path.GetInvalidFileNameChars()));
            var nome = $"{nomeComplemento}_Winthor_{dataArquivo.Value.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)}.xls";
            var etapa = Stopwatch.StartNew();
            var bytes = ExtracaoService.GerarPlanilhaExcel(itens);
            geracaoMs = etapa.Elapsed.TotalMilliseconds;
            tamanhoBytes = bytes.Length;
            RegistrarMemoria("DepoisGeracao", id);
            using var stream = new MemoryStream(bytes);
            using var streamReference = new DotNetStreamReference(stream);
            etapa.Restart();
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/extracao-vendas.js");
            await module.InvokeVoidAsync("baixarPlanilha", nome, streamReference);
            transferenciaMs = etapa.Elapsed.TotalMilliseconds;
            sucesso = true;

            empresa = string.Empty;
            dataArquivo = null;
            complemento = string.Empty;
            numerosTexto = string.Empty;
            LimparResultado();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao exportar planilha de vendas.");
            erro = "Não foi possível exportar a planilha. Consulte os registros da aplicação.";
        }
        finally
        {
            RegistrarMemoria("FimExportacao", id);
            Logger.LogInformation("Desempenho exportacao: extracaoId={ExtracaoId}, circuitoId={CircuitoId}, itens={QuantidadeItens}, bytes={TamanhoBytes}, geracaoMs={GeracaoMs}, transferenciaMs={TransferenciaMs}, duracaoMs={DuracaoMs}, sucesso={Sucesso}",
                id, MonitorCircuito.Id, quantidadeItens, tamanhoBytes, geracaoMs, transferenciaMs, cronometro.Elapsed.TotalMilliseconds, sucesso);
            ocupado = false;
        }
    }

    private void RegistrarMemoria(string etapa, string? id)
    {
        try
        {
            using var processo = Process.GetCurrentProcess();
            Logger.LogInformation("Memoria exportacao: extracaoId={ExtracaoId}, circuitoId={CircuitoId}, etapa={Etapa}, processoId={ProcessoId}, memoriaPrivadaBytes={MemoriaPrivadaBytes}, workingSetBytes={WorkingSetBytes}, gerenciadaBytes={GerenciadaBytes}",
                id, MonitorCircuito.Id, etapa, processo.Id, processo.PrivateMemorySize64, processo.WorkingSet64, GC.GetTotalMemory(false));
        }
        catch (Exception ex) when (ex is InvalidOperationException or System.ComponentModel.Win32Exception or NotSupportedException)
        {
            Logger.LogWarning(ex, "Não foi possível medir a memória do processo na etapa {Etapa}.", etapa);
        }
    }
}
